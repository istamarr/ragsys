install md to pdf 
# Install via winget
winget install JohnMacFarlane.Pandoc

# Convert MD to PDF
pandoc input.md -o output.pdf

# With custom styling
pandoc input.md -o output.pdf --pdf-engine=xelatex -V geometry:margin=1in



